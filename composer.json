{
    "name": "ggoitea/laravel-argidreader",
    "description": "Laravel package to read Argentine DNI cards from front/back images or PDFs using PDF417/QR barcodes, TD1 MRZ OCR and address extraction.",
    "keywords": [
        "laravel",
        "dni",
        "argentina",
        "renaper",
        "mrz",
        "pdf417",
        "ocr",
        "tesseract",
        "zxing",
        "barcode"
    ],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "illuminate/support": "^13.0",
        "nesbot/carbon": "^3.8",
        "psr/log": "^1.0 || ^2.0 || ^3.0",
        "symfony/process": "^7.4 || ^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Ggoitea\\LaravelArgIdReader\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ggoitea\\LaravelArgIdReader\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ggoitea\\LaravelArgIdReader\\ArgIdReaderProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
